{
  "name": "stockbyte-expo",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --tunnel --port 3000",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest"
  },
  "dependencies": {
    "expo": "^51.0.0",
    "expo-constants": "~16.0.1",
    "expo-linking": "~6.3.1",
    "expo-router": "^6.0.12",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "^0.81.4",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.5.0",
    "@shopify/flash-list": "^1.7.3",
    "@tanstack/react-query": "^5.62.2",
    "zustand": "^5.0.0-rc.2",
    "@react-native-async-storage/async-storage": "^1.23.1",
    "@supabase/supabase-js": "^2.45.4",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-get-random-values": "^1.11.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.6.0",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "react-test-renderer": "18.2.0",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "react-native",
    "setupFilesAfterEnv": ["@testing-library/jest-native/extend-expect"],
    "transformIgnorePatterns": [
      "node_modules/(?!(@react-native|react-native|react-native-url-polyfill|@react-native-async-storage|@shopify/flash-list|expo(nent)?|@expo(nent)?/.*|@expo/.*|expo-router|@supabase/supabase-js)/)"
    ]
  }
}
